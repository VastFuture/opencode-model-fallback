{
  "name": "opencode-runtime-fallback",
  "version": "1.0.2",
  "description": "Automatic model fallback plugin for OpenCode. Switches to backup models when API errors occur.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:package": "bun run build && bun run package-load.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "fallback",
    "model",
    "ai",
    "rate-limit",
    "quota",
    "auto-retry"
  ],
  "author": "youngbinkim0 (original), VastFuture (maintained)",
  "repository": {
    "type": "git",
    "url": "https://github.com/VastFuture/opencode-model-fallback.git"
  },
  "homepage": "https://github.com/VastFuture/opencode-model-fallback#readme",
  "bugs": {
    "url": "https://github.com/VastFuture/opencode-model-fallback/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.19",
    "bun-types": "1.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "jsonc-parser": "^3.3.1"
  }
}
